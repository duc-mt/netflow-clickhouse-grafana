{
  "title": "Băng thông thời gian thực (NetFlow)",
  "uid": "panos-netflow-realtime",
  "tags": [
    "palo-alto",
    "netflow"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Nguồn dữ liệu",
        "type": "datasource",
        "query": "grafana-clickhouse-datasource",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "options": [],
        "regex": ""
      },
      {
        "name": "client",
        "label": "Lọc máy (IP, để trống = tất cả)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "1. Băng thông theo hướng (cập nhật mỗi phút)",
      "description": "Từ NetFlow, Palo Alto gửi số liệu của phiên đang chạy mỗi 1 phút, nên lượt tải dài hiện dần.",
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT\n  $__timeInterval(ts) AS time,\n  sumIf(bytes, direction = 'Quốc tế')       * 8 / $__interval_s AS `Quốc tế`,\n  sumIf(bytes, direction = 'Trong nước')    * 8 / $__interval_s AS `Trong nước`,\n  sumIf(bytes, direction = 'Microsoft 365') * 8 / $__interval_s AS `Microsoft 365`\nFROM panos.flows\nWHERE $__timeFilter(ts) AND ('${client}' = '' OR local_ip = '${client}')\nGROUP BY time\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Quốc tế"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Trong nước"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Microsoft 365"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "2. Top 10 máy theo băng thông",
      "description": "Mỗi đường là một máy trong mạng (IP nội bộ), tính mọi hướng ra ngoài.",
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(ts) AS time, local_ip AS client, sum(bytes) * 8 / $__interval_s AS bps\nFROM panos.flows\nWHERE $__timeFilter(ts) AND direction != 'Nội bộ' AND ('${client}' = '' OR local_ip = '${client}')\n  AND local_ip IN (\n    SELECT local_ip FROM panos.flows\n    WHERE $__timeFilter(ts) AND direction != 'Nội bộ' AND ('${client}' = '' OR local_ip = '${client}')\n    GROUP BY local_ip ORDER BY sum(bytes) DESC LIMIT 10)\nGROUP BY time, client\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "displayName": "${__field.labels.client}",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${datasource}"
      }
    },
    {
      "type": "table",
      "title": "3. Máy đang dùng nhiều nhất (5 phút gần nhất)",
      "description": "Tốc độ trung bình 5 phút gần nhất. Bấm tiêu đề cột để xếp lại.",
      "timeFrom": "5m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "WITH dateDiff('second', $__fromTime, $__toTime) AS dur\nSELECT\n  local_ip AS `Máy`,\n  anyIf(user, user != '') AS `Người dùng`,\n  sumIf(bytes, direction = 'Quốc tế')       * 8 / dur AS `Quốc tế`,\n  sumIf(bytes, direction = 'Trong nước')    * 8 / dur AS `Trong nước`,\n  sumIf(bytes, direction = 'Microsoft 365') * 8 / dur AS `Microsoft 365`,\n  sum(bytes) * 8 / dur AS `Tổng`\nFROM panos.flows\nWHERE $__timeFilter(ts) AND direction != 'Nội bộ' AND ('${client}' = '' OR local_ip = '${client}')\nGROUP BY `Máy`\nORDER BY `Tổng` DESC\nLIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "decimals": 1,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Quốc tế"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Trong nước"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Microsoft 365"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tổng"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${datasource}"
      }
    },
    {
      "type": "table",
      "title": "4. Ứng dụng đang dùng nhiều nhất (5 phút gần nhất)",
      "description": "Ứng dụng theo App-ID của Palo Alto. Nhập IP ở ô Lọc máy để xem riêng một máy.",
      "timeFrom": "5m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "WITH dateDiff('second', $__fromTime, $__toTime) AS dur\nSELECT\n  if(app = '', '(chưa rõ)', app) AS `Ứng dụng`,\n  sumIf(bytes, direction = 'Quốc tế')       * 8 / dur AS `Quốc tế`,\n  sumIf(bytes, direction = 'Trong nước')    * 8 / dur AS `Trong nước`,\n  sumIf(bytes, direction = 'Microsoft 365') * 8 / dur AS `Microsoft 365`,\n  sum(bytes) * 8 / dur AS `Tổng`\nFROM panos.flows\nWHERE $__timeFilter(ts) AND direction != 'Nội bộ' AND ('${client}' = '' OR local_ip = '${client}')\nGROUP BY `Ứng dụng`\nORDER BY `Tổng` DESC\nLIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "decimals": 1,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Quốc tế"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
