# Sao chép:  cp .env.example .env && chmod 600 .env
#
# Mật khẩu: tối thiểu 12 ký tự, chỉ dùng A-Z a-z 0-9 . _ -
# Tránh $ # " ' \ vì làm hỏng việc đọc .env / docker compose.
# Sinh nhanh:  openssl rand -hex 16

CLICKHOUSE_USER=panos
CLICKHOUSE_PASSWORD=doi-mat-khau-nay
GRAFANA_ADMIN_PASSWORD=doi-mat-khau-nay

# IP của máy chủ Ubuntu này mà Palo Alto gửi Syslog/NetFlow tới (BẮT BUỘC điền)
COLLECTOR_IP=

# --- Tùy chọn: bật thu Syslog của hãng firewall khác (cách nhau bằng dấu phẩy) ---
# Hãng hỗ trợ: fortigate (UDP 5515), checkpoint (UDP 5516, BETA). Để trống = chỉ Palo Alto.
# NetFlow/IPFIX từ MỌI hãng (FortiGate, pfSense, Cisco, MikroTik...) luôn vào UDP 2055, không cần khai báo ở đây.
VENDORS=

# --- Tùy chọn: bỏ dấu # để ghi đè phiên bản đã ghim trong docker-compose.yml ---
# CLICKHOUSE_TAG=26.8
# GRAFANA_TAG=13.2.4
# VECTOR_TAG=0.56.0-debian

# --- Tùy chọn: xác minh checksum SHA256 (hex) của binary GoFlow2 ---
# Giá trị dưới đây là SHA256 của goflow2-2.2.7-linux-amd64 (đã đối chiếu khi đóng gói). Dùng cho máy amd64.
# GOFLOW2_SHA256=63d3bb6c4e458f56ae3268eac74979da1fee0cea5342362295e7d587784af14b
